# GenZee Tech Environment Configuration
# Copy this file to .env.local to configure credentials

# Website Base URL
NEXT_PUBLIC_SITE_URL=https://genzeetech.com

# Email notifications (Resend API)
RESEND_API_KEY=re_123456789
EMAIL_FROM=notifications@genzeetech.com
EMAIL_TO=info@genzeetech.com

# Optional SMTP Configuration (if using Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@genzeetech.com
SMTP_PASS=your_app_password
